PORT=9009
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api/v1

JWT_SECRET=<strong-random-secret-min-32-chars>
JWT_REFRESH_SECRET=<strong-random-refresh-secret-min-32-chars>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<initial-bootstrap-password>

EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=notifications@example.com
EMAIL_PASS=<smtp-password>
MAIL_FROM="HiveRift Desk <notifications@example.com>"
CONTACT_RECEIVER_EMAIL=admin@example.com

EXAM_AUTO_SUBMIT_CRON_INTERVAL_MS=15000
FINALIZING_RECOVERY_TIMEOUT_MS=30000
SUBMISSION_TRANSIT_GRACE_MS=15000

